<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LAUNDRYMANAGER</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LAUNDRYMANAGER.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- BUBBLE FILL LOADING SCREEN (Inspired by image_fe7447.jpg) -->
    <div id="loading-screen">
        <div class="machine-drum">
            <div class="drum-water"></div>
            <div class="bubble-texture"></div>
        </div>
    </div>
    <header>
        
                <div class="d-flex align-items-center justify-content-between w-100 px-4 py-3 bg-primary text-white shadow-sm">
                    <div class="d-flex align-items-center">
                        <!-- The New Logo Image -->
                <!-- Change from ~/images/OIP.webp to /images/OIP.webp -->
                <img src="/images/OIP.webp" alt="IWS Logo" width="35" height="35" class="me-2" />
                        <!-- Updated Title -->
                        <span class="fs-4 fw-bold">IWS Laundry Portal</span>
                    </div>

                    <!-- User Profile & Log Out section (Keep your existing right-side logic) -->
                    <div class="d-flex align-items-center gap-3">
                        <span><i class="bi bi-person-circle me-1"></i> 123456789@mywsu.ac.za</span>
                        <a href="#" class="btn btn-outline-light btn-sm fw-bold">Sign Out</a>
                    </div>
                </div>
                
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LAUNDRYMANAGER - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
