@model List<(DateTime Start, DateTime End, bool IsTaken)>
@using LaundryManager.Models

@{
    Layout = null;
    var machine = ViewBag.Machine as LaundryManager.Models.Machine;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book a Time Slot - iWS Laundry</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background: #f4f6f8;
        }

        .slot-btn {
            border-radius: 12px;
            padding: 0.75rem;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark shadow-sm mb-4" style="background:#12996b;">
        <div class="container">
            <span class="navbar-brand fw-bold">
                <i class="bi bi-water me-2"></i>iWS Laundry Portal
            </span>
            <a href="/Home/Index" class="btn btn-sm btn-outline-light fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </nav>

    <div class="container pb-5">
        <div class="row mb-4">
            <div class="col">
                <h2 class="fw-bold text-dark mb-1">Book a Time Slot</h2>
                @if (TempData["BookingConfirmation"] != null)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["BookingConfirmation"]
                    </div>
                }
                <p class="text-muted">
                    Choose a time for <strong>@machine?.Name</strong> (@machine?.Type) — each slot is
                    @(Machine.GetAverageDurationMinutes(machine?.Type ?? "Washer")) minutes long.
                </p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-warning">No more slots available today. Check back tomorrow.</div>
        }
        else
        {
            <div class="row g-2">
                @foreach (var slot in Model)
                {
                    <div class="col-6 col-md-3">
                        @if (slot.IsTaken)
                        {
                            <button class="btn btn-light slot-btn w-100 border text-muted" disabled>
                                @slot.Start.ToString("HH:mm") - @slot.End.ToString("HH:mm")
                                <br /><small>Taken</small>
                            </button>
                        }
                        else
                        {
                            <form action="/Bookings/Reserve" method="post">
                                <input type="hidden" name="machineId" value="@machine?.Id" />
                                <input type="hidden" name="slotStart" value="@slot.Start.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                <input type="hidden" name="slotEnd" value="@slot.End.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                <button type="submit" class="btn btn-success slot-btn w-100">
                                    @slot.Start.ToString("HH:mm") - @slot.End.ToString("HH:mm")
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>

</body>
</html>