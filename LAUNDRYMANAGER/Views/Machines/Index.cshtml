@model IEnumerable<LaundryManager.Models.Machine>
@using LaundryManager.Models

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Machines - WSU Laundry Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <span class="navbar-brand fw-bold text-warning">
                <i class="bi bi-shield-lock-fill me-2"></i>WSU Laundry Admin Portal
            </span>
            <div class="d-flex align-items-center">
                <a href="/Home/AdminDashboard" class="btn btn-sm btn-outline-light fw-bold me-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
                <a href="/Account/Logout" class="btn btn-sm btn-outline-light fw-bold">Sign Out</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h2 class="fw-bold text-dark">All Machines</h2>
                <p class="text-muted">View and manage every washer and dryer registered in the system.</p>
            </div>
            <div class="col-auto d-flex align-items-center">
                <button type="button" class="btn btn-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addMachineModal">
                    <i class="bi bi-plus-circle me-1"></i> Add New Machine
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-inbox display-4 d-block mb-3"></i>
                        No machines added yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-uppercase fs-7 font-monospace">
                                <tr>
                                    <th class="ps-4">Name</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Booking</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var machine in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@machine.Name</td>
                                        <td>@machine.Type</td>
                                        <td>
                                            @if (machine.Status == MachineStatus.Working)
                                            {
                                                <span class="badge bg-success">Working</span>
                                            }
                                            else if (machine.Status == MachineStatus.UnderRepair)
                                            {
                                                <span class="badge bg-warning text-dark">Under Repair</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Out of Order</span>
                                            }
                                        </td>
                                        <td>
                                            @if (machine.IsBooked)
                                            {
                                                <span class="text-muted small">Booked by @machine.BookedBy</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Free</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                                                    <input type="hidden" name="id" value="@machine.Id" />
                                                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                                        <option value="@MachineStatus.Working" selected="@(machine.Status == MachineStatus.Working)">Working</option>
                                                        <option value="@MachineStatus.UnderRepair" selected="@(machine.Status == MachineStatus.UnderRepair)">Under Repair</option>
                                                        <option value="@MachineStatus.OutOfOrder" selected="@(machine.Status == MachineStatus.OutOfOrder)">Out of Order</option>
                                                    </select>
                                                </form>

                                                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete @machine.Name? This cannot be undone.');">
                                                    <input type="hidden" name="id" value="@machine.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Add New Machine Modal -->
    <div class="modal fade" id="addMachineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle text-warning me-2"></i>Add New Machine
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Machines" asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Name</label>
                            <input name="Name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Type</label>
                            <select name="Type" class="form-select" required>
                                <option value="">-- Select Type --</option>
                                <option value="Washer">Washer</option>
                                <option value="Dryer">Dryer</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="Status" class="form-select" asp-items="Html.GetEnumSelectList<MachineStatus>()"></select>
                        </div>
                        <button type="submit" class="btn btn-dark fw-bold w-100">
                            <i class="bi bi-check-circle me-1"></i> Add Machine
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>