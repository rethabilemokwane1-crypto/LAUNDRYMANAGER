@model LaundryManager.Models.Machine
@using LaundryManager.Models
@{
    Layout = null;
    ViewData["Title"] = "Add New Machine";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New Machine - WSU Laundry Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <span class="navbar-brand fw-bold text-warning">
                <i class="bi bi-shield-lock-fill me-2"></i>WSU Laundry Admin Portal
            </span>
            <div class="d-flex align-items-center">
                <a href="/Machines" class="btn btn-sm btn-outline-light fw-bold me-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Machines
                </a>
                <a href="/Account/Logout" class="btn btn-sm btn-outline-light fw-bold">Sign Out</a>
            </div>
        </div>
    </nav>

    <div class="container" style="max-width: 640px;">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <h2 class="fw-bold text-dark mb-4">
                    <i class="bi bi-plus-circle text-warning me-2"></i>Add New Machine
                </h2>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label fw-semibold"></label>
                        <select asp-for="Type" class="form-select">
                            <option value="">-- Select Type --</option>
                            <option value="Washer">Washer</option>
                            <option value="Dryer">Dryer</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select"
                                asp-items="Html.GetEnumSelectList<MachineStatus>()">
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark fw-bold px-4">
                        <i class="bi bi-check-circle me-1"></i> Add Machine
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Cancel</a>
                </form>
            </div>
        </div>
    </div>

</body>
</html>