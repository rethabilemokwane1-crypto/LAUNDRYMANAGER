@{
    Layout = null; // Bypasses default templates to keep our layout clean
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Report Fault - WSU Laundry</title>
    <!-- Bootstrap CSS Framework for clean layout boxes and buttons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Top Navigation Header -->
    <nav class="navbar navbar-dark bg-primary shadow-sm mb-5">
        <div class="container">
            <span class="navbar-brand fw-bold">WSU Laundry Portal</span>
            <span class="text-white small">👤 @ViewBag.StudentEmail</span>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <!-- Back Button Navigation Link -->
                <a href="/Home/Index" class="text-decoration-none text-secondary d-inline-block mb-3 fw-bold">
                    ← Back to Dashboard
                </a>

                <!-- Main Interactive Form Card Box -->
                <div class="card shadow border-0 p-4 rounded-3 bg-white">
                    <h3 class="fw-bold text-dark mb-1">Submit Fault Report</h3>
                    <p class="text-muted small mb-4">Report an operational issue directly to the maintenance team.</p>

                    <form action="/Home/ReportFault" method="post">
                        <!-- Hidden machine ID passed securely to backend logic -->
                        <input type="hidden" name="machineId" value="@ViewBag.MachineId" />

                        <!-- Readonly Equipment Indicator Field -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">Selected Equipment Asset</label>
                            <input type="text" class="form-control bg-light fw-bold text-dark" value="@ViewBag.MachineName" readonly />
                        </div>

                        <!-- FEEDBACK PANEL SECTION -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-primary">
                                💬 Student Feedback Panel (Write what's happening below):
                            </label>
                            <textarea name="description" class="form-control border-primary" rows="5"
                                      placeholder="Explain the problem here... (e.g., The machine took my tokens but the drum won't spin, or it is leaking water from the bottom during the rinse cycle)"
                                      required></textarea>
                            <div class="form-text text-muted">Be as specific as possible so our technicians know what tools to bring.</div>
                        </div>

                        <!-- Action Controls Button Panel -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger w-50 fw-bold shadow-sm">Submit Report</button>
                            <a href="/Home/Index" class="btn btn-outline-secondary w-50 fw-bold">Cancel</a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>

</body>
</html>