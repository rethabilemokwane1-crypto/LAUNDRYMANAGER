@{
    Layout = null;
    ViewData["Title"] = "Admin Home";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Home - WSU Laundry Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <span class="navbar-brand fw-bold text-warning">
                <i class="bi bi-shield-lock-fill me-2"></i>WSU Laundry Admin Portal
            </span>
            <a href="/Account/Logout" class="btn btn-sm btn-outline-light fw-bold">Sign Out</a>
        </div>
    </nav>

    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h2 class="fw-bold text-dark">Admin Home</h2>
                <p class="text-muted">Choose a tool below to manage the laundry system.</p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <a href="/Machines" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center">
                        <i class="bi bi-list-ul display-5 mb-3" style="color:#b8860b;"></i>
                        <h5 class="fw-bold text-dark mb-1">Manage Machines</h5>
                        <p class="text-muted small mb-0">Add, remove, or update machine status</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="/Machines/Create" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center">
                        <i class="bi bi-plus-circle display-5 mb-3" style="color:#b8860b;"></i>
                        <h5 class="fw-bold text-dark mb-1">Add New Machine</h5>
                        <p class="text-muted small mb-0">Register a new washer or dryer</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="/Home/AdminDashboard" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center">
                        <i class="bi bi-tools display-5 mb-3" style="color:#b8860b;"></i>
                        <h5 class="fw-bold text-dark mb-1">Fault Reports</h5>
                        <p class="text-muted small mb-0">Review and resolve maintenance requests</p>
                    </div>
                </a>
            </div>
        </div>
    </div>

</body>
</html>
