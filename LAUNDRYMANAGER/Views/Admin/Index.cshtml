@{
    Layout = null; // Forces the page to ignore any broken layout templates
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - WSU Laundry</title>
    <!-- Bootstrap Stylesheet -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-dark bg-dark shadow-sm">
        <div class="container">
            <span class="navbar-brand fw-bold text-danger">WSU Laundry Admin Panel</span>
            <a href="/Account/Logout" class="btn btn-sm btn-outline-light fw-bold">Sign Out</a>
        </div>
    </nav>

    <!-- Main Dashboard Container -->
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card p-5 shadow border-0 text-center bg-white rounded-4">
                    <div class="display-1 text-success mb-3">🎉</div>
                    <h2 class="fw-bold text-dark mb-3">Authentication Successful!</h2>
                    <p class="text-muted fs-5 mb-4">
                        Your login routing and role separation work 100% perfectly.
                        The system successfully recognized you as the administrator.
                    </p>
                    <hr class="my-4">
                    <p class="small text-secondary">
                        Ready to move forward to building the actual machine controls and student request systems.
                    </p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
