@model LaundryManager.Models.RegisterViewModel

@{
    Layout = null; // Stops other layout files from overriding our styling
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - iWS Laundry Portal</title>
    <!-- Direct link to Bootstrap styles for clean visuals -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--iws-page-bg); min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4">

                        <div class="text-center mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                                 style="width:70px; height:70px; background-color: var(--iws-bubble-white);">
                                <i class="bi bi-person-plus-fill fs-2" style="color: var(--iws-water-color);"></i>
                            </div>
                            <h3 class="fw-bold mb-1" style="color: var(--iws-water-color);">Create Account</h3>
                            <p class="text-muted small mb-0">Register with your WSU student credentials</p>
                        </div>

                        <form asp-action="Register" method="post">
                            <!-- This displays general errors, like if the email is already taken -->
                            <div class="text-danger small mb-3" asp-validation-summary="ModelOnly"></div>

                            <!-- Student Email Input -->
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">WSU Student Email</label>
                                <input asp-for="Email" class="form-control" placeholder="e.g. 221098765@@mywsu.ac.za" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password Input -->
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Create password" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Confirm Password Input -->
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Retype password" required />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <!-- Security Question Input -->
                            <div class="mb-4">
                                <label asp-for="SecurityAnswer" class="form-label fw-semibold">
                                    Security Question: What is the name of your first pet?
                                </label>
                                <input asp-for="SecurityAnswer" class="form-control" placeholder="Your answer" required />
                                <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-success w-100 fw-bold">
                                <i class="bi bi-check-circle me-1"></i> Register
                            </button>
                        </form>

                        <!-- Link to navigate back to the Login screen -->
                        <div class="text-center mt-4">
                            <span class="text-muted small">Already registered?</span>
                            <a href="/Account/Login" class="small fw-bold text-decoration-none text-success ms-1">Login Here</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Client-side validation scripts so the page checks mistakes instantly without reloading -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>