@model LaundryManager.Models.LoginViewModel

@{
    Layout = null; // Stops other layout files from messing up our styling
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - iWS Laundry Portal</title>
    <!-- Direct link to Bootstrap styles for clean visuals -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-4">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4">
                        <h3 class="text-center mb-2 fw-bold text-primary">iWS Laundry Portal</h3>
                        <p class="text-muted text-center small mb-4">Sign in to book machines</p>

                        <form asp-action="Login" method="post">
                            <!-- This displays general login errors, like "Invalid email or password" -->
                            <div class="text-danger small mb-3" asp-validation-summary="ModelOnly"></div>

                            <!-- Student Email Input -->
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">iWS Student Email</label>
                                <input asp-for="Email" class="form-control" placeholder="e.g. 221098765@@mywsu.ac.za" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password Input -->
                            <div class="mb-2">
                                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Forgot Password link -->
                            <div class="text-end mb-4">
                                <a href="/Account/ForgotPassword" class="small text-decoration-none text-primary">Forgot Password?</a>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary w-100 fw-bold">Sign In</button>
                        </form>

                        <!-- Link to navigate over to the Registration screen -->
                        <div class="text-center mt-4">
                            <span class="text-muted small">Don't have an account?</span>
                            <a href="/Account/Register" class="small fw-bold text-decoration-none text-primary ms-1">Register Here</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Client-side validation scripts so the page checks mistakes instantly without reloading -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>