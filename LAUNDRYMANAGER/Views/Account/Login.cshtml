@model LaundryManager.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - iWS Laundry Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--iws-page-bg); min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                                 style="width:70px; height:70px; background-color: var(--iws-bubble-white);">
                                <i class="bi bi-water fs-2" style="color: var(--iws-water-color);"></i>
                            </div>
                            <h3 class="fw-bold mb-1" style="color: var(--iws-water-color);">iWS Laundry Portal</h3>
                            <p class="text-muted small mb-0">Sign in to book machines</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <div class="text-danger small mb-3" asp-validation-summary="ModelOnly"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">iWS Student Email</label>
                                <input asp-for="Email" class="form-control" placeholder="e.g. 221098765@@mywsu.ac.za" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-2">
                                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="text-end mb-4">
                                <a href="/Account/ForgotPassword" class="small text-decoration-none" style="color: var(--iws-water-color);">Forgot Password?</a>
                            </div>

                            <button type="submit" class="btn btn-success w-100 fw-bold">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </button>
                        </form>

                        <div class="text-center mt-4">
                            <span class="text-muted small">Don't have an account?</span>
                            <a href="/Account/Register" class="small fw-bold text-decoration-none text-success ms-1">Register Here</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>