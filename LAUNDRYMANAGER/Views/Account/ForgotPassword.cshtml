@model LaundryManager.Models.ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - WSU Laundry Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-4">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4">
                        <h3 class="text-center mb-2 fw-bold text-success">Forgot Password</h3>
                        <p class="text-muted text-center small mb-4">Enter your WSU email to begin resetting your password</p>

                        <form asp-action="ForgotPassword" method="post">
                            <div class="text-danger small mb-3" asp-validation-summary="ModelOnly"></div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-semibold">WSU Student Email</label>
                                <input asp-for="Email" class="form-control" placeholder="e.g. 221098765@@mywsu.ac.za" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-success w-100 fw-bold">Next</button>
                        </form>

                        <div class="text-center mt-4">
                            <a href="/Account/Login" class="small fw-bold text-decoration-none text-success ms-1">Back to Login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
