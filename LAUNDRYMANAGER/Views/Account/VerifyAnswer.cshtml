@model LaundryManager.Models.VerifyAnswerViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Question - WSU Laundry Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-4">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4">
                        <h3 class="text-center mb-2 fw-bold text-success">Security Question</h3>
                        <p class="text-muted text-center small mb-4">Answer your security question to continue</p>

                        <form asp-action="VerifyAnswer" method="post">
                            <div class="text-danger small mb-3" asp-validation-summary="ModelOnly"></div>

                            <!-- Hidden field: carries the email forward without the user seeing it -->
                            <input type="hidden" asp-for="Email" />

                            <div class="mb-4">
                                <label asp-for="SecurityAnswer" class="form-label fw-semibold">
                                    What is the name of your first pet?
                                </label>
                                <input asp-for="SecurityAnswer" class="form-control" placeholder="Your answer" required />
                                <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-success w-100 fw-bold">Verify</button>
                        </form>

                        <div class="text-center mt-4">
                            <a href="/Account/Login" class="small fw-bold text-decoration-none text-success ms-1">Back to Login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>